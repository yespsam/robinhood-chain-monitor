From f74e1095c988b26aaac9f97dd8d58bde3c2ce04c Mon Sep 17 00:00:00 2001
From: flapguy <178278174+flapguy@users.noreply.github.com>
Date: Fri, 21 Aug 2026 18:19:19 +0000
Subject: [PATCH] feat(launch-bnb-token-on-flap): tax-only tokens +
 configurable quote tokens

- Remove the standard (non-tax, TOKEN_V2_PERMIT) token launch path.
- Add references/quote-tokens.md documenting GET
  https://flap.sh/api/launch/quote-tokens and filter to chainId 56.
---
diff --git a/launch-bnb-token-on-flap/SKILL.md b/launch-bnb-token-on-flap/SKILL.md
index 1111111..2222222 100644
--- a/launch-bnb-token-on-flap/SKILL.md
+++ b/launch-bnb-token-on-flap/SKILL.md
@@ -26,6 +26,7 @@ skills/launch-bnb-token-on-flap/
     ├── preflight.md                ← Step 0: prerequisites
+    ├── quote-tokens.md              ← Step 1: quote token selection
     ├── vault-factory.md            ← Step 2: vault factory setup
@@ -52,18 +54,22 @@ Check each file exists, then read `references/preflight.md` and verify every pre
-## Step 1 — Choose token type
+## Step 1 — Choose token type and quote token
+Every token launched by this skill is a **Flap Tax Token V3** (`TOKEN_TAXED_V3`). Standard
+(non-tax) tokens are out of scope for this skill.
-1. **Tax token or standard (non-tax) token?**
-2. If tax token: **Use a Vault Factory for revenue management?**
+1. **Use a Vault Factory for revenue management?**
+2. **Which quote token to launch against?** Read `references/quote-tokens.md` to fetch the
+   current list of supported quote tokens on BNB Chain and resolve the `quoteToken` address and
+   `decimals` to use in later steps. Defaults to native BNB if the user has no preference.
-| Standard token | `Portal.newTokenV6` with `tokenVersion = TOKEN_V2_PERMIT` |
 | Tax token, no vault | `Portal.newTokenV6` with `tokenVersion = TOKEN_TAXED_V3` |
@@ -102,8 +108,11 @@ Read `references/tax-params.md` to determine and validate:
-Determine `quoteAmt`: the amount of BNB to spend on the initial buy at launch. This becomes both the `quoteAmt` field and the `msg.value` of the transaction.
+Determine `quoteAmt`: the amount of the chosen quote token to spend on the initial buy at launch.
+If the quote token is native BNB, this also equals the `msg.value` of the transaction; for any
+other (ERC-20) quote token, `msg.value` is `0` and the wallet must instead hold and approve
+`quoteAmt` of that token beforehand.
diff --git a/launch-bnb-token-on-flap/references/construct-tx.md b/launch-bnb-token-on-flap/references/construct-tx.md
index 3333333..4444444 100644
--- a/launch-bnb-token-on-flap/references/construct-tx.md
+++ b/launch-bnb-token-on-flap/references/construct-tx.md
@@ -120,3 +120,5 @@ const params = {
-const value = parseEther(quoteAmtBnb);
+const isNativeQuote = quoteToken === "0x0000000000000000000000000000000000000000";
+const value = isNativeQuote ? quoteAmt : 0n;
+// ERC-20 quote tokens require approve(to, quoteAmt) before launch.
diff --git a/launch-bnb-token-on-flap/references/quote-tokens.md b/launch-bnb-token-on-flap/references/quote-tokens.md
new file mode 100644
index 0000000..5555555
--- /dev/null
+++ b/launch-bnb-token-on-flap/references/quote-tokens.md
@@ -0,0 +1,10 @@
+# Choosing a Quote Token
+GET https://flap.sh/api/launch/quote-tokens
+The response lists supported quote tokens across all chains Flap supports.
+This skill only launches on BNB Chain (chainId 56), so filter to `chainId == 56`.
+Resolve the selected token's `quoteToken` address and `decimals`.
+For an ERC-20 quote token, approve the Portal or VaultPortal for `quoteAmt` and set `msg.value = 0`.
