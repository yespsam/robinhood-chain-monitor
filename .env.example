GITHUB_POLL_CONCURRENCY=4
GITHUB_PRIORITY_POLL_CONCURRENCY=6
GITHUB_PRIORITY_POLL_INTERVAL_MS=5000
# Bounds a single GitHub HTTP request so one unhealthy repository cannot hold
# the core fast lane for an entire scheduler cycle.
GITHUB_REQUEST_TIMEOUT_MS=8000
GITHUB_DYNAMIC_POLL_INTERVAL_MS=300000
# With no token the monitor enforces a 10-minute floor (24 list requests/hour
# across the four curated official repositories); a token allows 60 seconds.
GITHUB_PR_POLL_INTERVAL_MS=60000
GITHUB_ORGANIZATION_POLL_INTERVAL_MS=600000
GITHUB_RETRY_BASE_MS=60000
GITHUB_RETRY_MAX_MS=3600000
UNISWAP_MONITOR_ENABLED=true
XAI_OFFICIAL_MONITOR_ENABLED=true
# Production focus mode keeps Flap, Four.Meme, and Uniswap/Pools.trade narrow;
# Binance is a separate strict official-source opt-in lane.
MONITOR_SCOPE=focus3
BINANCE_MONITOR_ENABLED=true
BINANCE_ANNOUNCEMENT_STREAM_ENABLED=true
# Optional read-only Binance API credentials enable the official real-time
# announcement WebSocket. Never grant trading or withdrawal permissions.
BINANCE_API_KEY=
BINANCE_API_SECRET=
