FOMO_HEALTH_ZERO_TARGET_AGE_MS=300000
FOMO_HEALTH_OUTBOX_FAILED_AGE_MS=120000
FOMO_HEALTH_OUTBOX_PENDING_AGE_MS=300000
FOMO_HEALTH_DELIVERY_RETRY_MS=30000

