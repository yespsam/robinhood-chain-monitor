# Morph 独立高信号通道：普通 Flap 发币静默；只推 Portal 升级、官方新模式
# 及其首个代币。Long 在官方公布 Morph 部署前只监控官网与 @longdotxyz，
# 不按名称猜测链上合约。HTTP 游标负责补漏，WebSocket 只做低延迟触发。
MORPH_MONITOR_ENABLED=true
MORPH_RPC_URL=https://rpc.morph.network
MORPH_RPC_URLS=https://rpc.morph.network,https://rpc.morphl2.io
MORPH_WS_URL=wss://rpc.morph.network
MORPH_EXPLORER_API_URL=https://explorer-api.morph.network
MORPH_RPC_REQUEST_TIMEOUT_MS=5000
MORPH_CONFIRMATIONS=1
MORPH_POLL_INTERVAL_MS=1000
MORPH_OFFICIAL_POLL_INTERVAL_MS=10000
MORPH_LOG_BATCH_SIZE=2000
MORPH_BASELINE_RECENT_BLOCKS=100000
MORPH_MAX_CATCHUP_BLOCKS=5000
MORPH_REORG_LOOKBACK_BLOCKS=8
WEBHOOK_URL=

