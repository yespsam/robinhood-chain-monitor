SITE_RETRY_BASE_MS=15000
SITE_RETRY_MAX_MS=3600000
SITE_BLOCKED_RETRY_MS=1800000
SITE_NOT_FOUND_RETRY_MS=21600000
SITE_RECOVERY_ALERT_WINDOW_MS=600000
TWITTER_MONITOR_ENABLED=true
# Independent fail-closed lanes: when ordinary X is off, only fresh (<2h)
# high-confidence @binance/@BinanceWallet product launches plus fresh (<10m)
# structural @flapdotsh/@fourdotmemezh launchpad changes are monitored.
BINANCE_CRITICAL_X_MONITOR_ENABLED=true
BINANCE_CRITICAL_X_MAX_AGE_MS=7200000
FOCUS_CRITICAL_X_MONITOR_ENABLED=true
FOCUS_CRITICAL_X_MAX_AGE_MS=600000
# Critical cycles run at sub-second cadence and carry one non-extendable
# five-second deadline through discovery, dual verification and alert delivery.
# External X/public-cache publication lag remains outside local control.
BINANCE_CRITICAL_X_SCHEDULER_INTERVAL_MS=250
BINANCE_CRITICAL_X_DISCOVERY_INTERVAL_MS=500
BINANCE_CRITICAL_X_POLL_ALLOWANCE_MS=1000
BINANCE_CRITICAL_X_DISCOVERY_TIMEOUT_MS=2000
BINANCE_CRITICAL_X_VERIFY_TIMEOUT_MS=1750
BINANCE_CRITICAL_X_LOCAL_BUDGET_MS=5000
TWITTER_POLL_INTERVAL_MS=1000
# Priority official accounts are polled in stable order with bounded sockets.
TWITTER_PRIORITY_POLL_CONCURRENCY=4
# Standard accounts are selected fairly from a durable cursor; priority accounts use a separate lane.
TWITTER_STANDARD_POLL_CONCURRENCY=2
TWITTER_REQUEST_TIMEOUT_MS=6000
TWITTER_DIRECT_REQUEST_TIMEOUT_MS=4000
TWITTER_SYNDICATION_REQUEST_TIMEOUT_MS=5000
TWITTER_JINA_REQUEST_TIMEOUT_MS=8000
TWITTER_PRIORITY_TARGET_BUDGET_MS=12000
TWITTER_STANDARD_TARGET_BUDGET_MS=15000
# Failed critical public sources open a durable per-account/source circuit.
TWITTER_CRITICAL_DISCOVERY_FAILURE_MIN_BACKOFF_MS=15000
TWITTER_CRITICAL_DISCOVERY_FAILURE_MAX_BACKOFF_MS=300000
# Repeat failures are summarized at most once per interval; transitions log immediately.
TWITTER_FAILURE_LOG_SUMMARY_INTERVAL_MS=900000
# First-party public X SSR for verified accounts; strict user-id validation is required.
TWITTER_DIRECT_X_ENABLED=true
# Numeric-ID timeline discovery is cross-checked against the official X
# oEmbed endpoint before any new post can enter alert classification.
TWITTER_FXTWITTER_ENABLED=true
TWITTER_FXTWITTER_API_BASE=https://api.fxtwitter.com
TWITTER_FXTWITTER_MIN_INTERVAL_MS=5000
TWITTER_CRITICAL_FXTWITTER_MIN_INTERVAL_MS=5000
TWITTER_OFFICIAL_OEMBED_CONCURRENCY=2
# Free, no-key public X embed timeline. Can be replaced if X changes it.
TWITTER_API_BASE=https://syndication.twitter.com/srv/timeline-profile/screen-name
TWITTER_FALLBACK_API_BASES=https://r.jina.ai/https://x.com/{handle},https://r.jina.ai/https://twitter.com/{handle},https://r.jina.ai/http://x.com/{handle}
TWITTER_JINA_MIN_INTERVAL_MS=300000
TWITTER_JINA_DETAIL_LIMIT=4
TWITTER_BACKFILL_LIMIT=8
TWITTER_BACKFILL_SCAN_LIMIT=40
TWITTER_BACKFILL_MAX_AGE_MS=604800000
PLATFORM_CAPABILITY_POLL_INTERVAL_MS=5000
# Board/config/package checks stay first while total outbound sockets remain bounded.
PLATFORM_CAPABILITY_CONCURRENCY=4
PLATFORM_CAPABILITY_REQUEST_TIMEOUT_MS=8000
# Stagger exactly one Flap/Four structured request per tick; each URL remains
# conditional and is never requested more often than once per 1500ms.
PLATFORM_CAPABILITY_FAST_SCHEDULER_INTERVAL_MS=500
PLATFORM_CAPABILITY_FAST_SOURCE_INTERVAL_MS=1500
PLATFORM_CAPABILITY_FAST_REQUEST_TIMEOUT_MS=2000
# Directly monitor finalized Flap Portal QuoteTokenConfigurationSet events on
# BSC. The first start establishes a quiet head baseline; later enables are
# receipt-, implementation-, metadata- and canonical-block verified.
FLAP_QUOTE_MONITOR_ENABLED=true
FLAP_QUOTE_POLL_INTERVAL_MS=3000
FLAP_QUOTE_CONFIRMATIONS=3
FLAP_QUOTE_EVENT_CHUNK_SIZE=4096
FLAP_QUOTE_MAX_BLOCKS_PER_CYCLE=4096
FLAP_QUOTE_LOG_MAX_BLOCK_SPAN=4096
FLAP_QUOTE_LOG_CONCURRENCY=1
FLAP_QUOTE_BACKOFF_BASE_MS=3000
FLAP_QUOTE_BACKOFF_MAX_MS=300000
# Two fixed, distinct physical origins are required in each lane. Log queries
# are split into bounded pages and must agree exactly; state readers separately
# quorum finalized and historical Portal calls. PublicNode is intentionally not
# used here because its anonymous BSC archive window is too short for outages.
FLAP_QUOTE_LOG_RPC_URLS=https://rpc-bnb.blockmachine.io,https://rpc.48.club
FLAP_QUOTE_STATE_RPC_URLS=https://rpc-bnb.blockmachine.io,https://bsc-mainnet.public.blastapi.io
# Finalized OpenFour Registry/Core fallback for Four.Meme capability changes.
# The first start establishes a silent head baseline; only later canonical
# Registry changes and their first TokenCreated confirmation can notify.
FOUR_REGISTRY_MONITOR_ENABLED=true
FOUR_REGISTRY_POLL_INTERVAL_MS=5000
FOUR_REGISTRY_CATCH_UP_INTERVAL_MS=5000
FOUR_REGISTRY_CONFIRMATIONS=3
FOUR_REGISTRY_LOG_CHUNK_SIZE=4096
FOUR_REGISTRY_REORG_LOOKBACK_BLOCKS=64
# Two independent physical readers must return the same canonical logs before
# the Registry cursor advances. Historical state is verified independently too.
FOUR_REGISTRY_LOG_RPC_URLS=https://rpc-bnb.blockmachine.io,https://rpc.48.club
FOUR_REGISTRY_STATE_RPC_URLS=https://rpc-bnb.blockmachine.io,https://bsc-mainnet.public.blastapi.io
# Master switch for every Pons-specific source (chain/version, GitHub, X, site,
# official addresses and alert delivery). Disabling it keeps all saved cursors.
PONS_MONITOR_ENABLED=false
PONS_VERSION_POLL_INTERVAL_MS=5000
# pon.fun is unrelated to pons.family. Its source gate pins Robinhood chain
# 4663, the exact Factory address/runtime fingerprint, official JSON endpoints
# and Factory getters before any event can reach the alert outbox.
PON_MONITOR_ENABLED=true
PON_POLL_INTERVAL_MS=3000
# /api/markets can take several seconds from mainland networks; keep this
# bounded but high enough to avoid treating normal latency as an outage.
PON_REQUEST_TIMEOUT_MS=10000
PON_EVENT_CHUNK_SIZE=2000
PON_MAX_BLOCKS_PER_CYCLE=10000
PON_BACKOFF_BASE_MS=5000
PON_BACKOFF_MAX_MS=300000
PON_PENDING_LIMIT=500
PON_REORG_REWIND_BLOCKS=128
PON_API_MAX_BLOCK_LAG=128
PON_FINALIZED_CHECKPOINT_LIMIT=256
PON_REORG_ORPHANED_EVENT_LIMIT=500
PON_PENDING_BATCH_SIZE=20
PON_VALIDATION_CONCURRENCY=4
BINANCE_ANNOUNCEMENT_POLL_INTERVAL_MS=10000
BINANCE_ANNOUNCEMENT_DETAIL_POLL_INTERVAL_MS=10000
BINANCE_MEME_RUSH_POLL_INTERVAL_MS=5000
BINANCE_LAUNCHPOOL_POLL_INTERVAL_MS=10000
BINANCE_SQUARE_POLL_INTERVAL_MS=5000
BINANCE_DEVELOPER_POLL_INTERVAL_MS=10000

# Fomo 平台喊单：只接受 fomo.family 实际发布的 Trade Thesis
#（官方 Feed 的 thesis_created / thesis），不把钱包买入推断成喊单。
# 钱包买入链路已弃用且默认关闭；没有有效 Thesis 凭证时 fail-closed，
# 不发送告警，也不会回退到钱包买入。
FOMO_CALL_ENABLED=true
FOMO_CALL_STANDALONE=true
FOMO_BUY_MONITOR_ENABLED=false
FOMO_PUBLISHED_CALL_ENABLED=true

# 主进程独立健康 watchdog：即使 standalone Fomo worker 卡死/退出，仍从
# 持久状态判断 Smart Money、BSC、X、Thesis 与 Fomo outbox，并只在持续
# 严重降级/稳定恢复的转场各播报一次。零目标需至少 2 个源周期且持续 5 分钟。
FOMO_HEALTH_MONITOR_ENABLED=true
FOMO_HEALTH_POLL_INTERVAL_MS=30000
FOMO_HEALTH_STATE_STALE_MS=180000
