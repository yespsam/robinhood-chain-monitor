UNISWAP_GITHUB_POLL_INTERVAL_MS=10000
UNISWAP_MAX_BACKOFF_MS=900000
UNISWAP_REQUEST_TIMEOUT_MS=10000
# X/X API, xAI and Grok official machine-readable sources. The first poll is
