ALERT_TELEGRAM_DELIVERY_MAX_AGE_MS=7200000
# Reliable source-time freshness gate: <=10m realtime, <=2h late/backfill,
# >2h suppressed from Telegram while remaining in the durable outbox audit.
ALERT_BSC_REALTIME_MAX_AGE_MS=600000
ALERT_BSC_TELEGRAM_MAX_AGE_MS=7200000
ALERT_MORPH_REALTIME_MAX_AGE_MS=600000
ALERT_MORPH_TELEGRAM_MAX_AGE_MS=7200000
