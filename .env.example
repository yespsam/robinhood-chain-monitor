X_API_CHANGELOG_POLL_INTERVAL_MS=10000
XAI_RELEASE_NOTES_POLL_INTERVAL_MS=10000
XAI_NEWS_POLL_INTERVAL_MS=30000
XAI_OFFICIAL_REQUEST_TIMEOUT_MS=10000
XAI_OFFICIAL_MAX_BACKOFF_MS=900000
